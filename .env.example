# Copy to .env.local and fill in. Never commit real values.

# Neon (written automatically by `neon link`)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Optional: a separate Neon branch for integration tests
DATABASE_URL_TEST=

# Hugging Face fine-grained token with "Make calls to Inference Providers"
HF_TOKEN=
# Optional model overrides (defaults shown)
HF_ASR_MODEL=openai/whisper-large-v3-turbo
HF_ASR_FALLBACK_MODEL=openai/whisper-large-v3
HF_LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct
HF_LLM_FALLBACK_MODEL=meta-llama/Llama-3.1-8B-Instruct
# Local and E2E only: return fixture AI responses instead of calling Hugging Face
HF_MOCK=

# 32+ random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
# Public origin of the app, no trailing slash
APP_ORIGIN=http://localhost:3000
# Clone the sample history into each new guest
DEMO_SEED_ON_GUEST=true
